{
  "manifest_version": 3,
  "name": "MyEpitechStats",
  "version": "1.0.0",
  "description": "Timeline view of your Epitech modules and projects, scraped from my.epitech.eu, for planning your credit strategy.",
  "permissions": ["storage", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://my.epitech.eu/*"],
      "js": ["browser-polyfill.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["browser-polyfill.js", "background.js"]
  },
  "action": {
    "default_title": "Open MyEpitechStats",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["stats.html", "stats.css", "stats.js", "types.js"],
      "matches": ["https://my.epitech.eu/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{a54d2b2c-01af-4890-bbb1-a58ce42f0b04}",
      "strict_min_version": "109.0"
    }
  }
}
